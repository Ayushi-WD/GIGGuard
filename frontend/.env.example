# The FastAPI server the Next.js rewrite proxy points at.
# Copy this file to `.env.local` if your backend runs elsewhere.
BACKEND_URL=http://127.0.0.1:8001

# Optional: bypass the Next.js proxy and call the API directly from the browser.
# If you use this, make sure the backend CORS allowlist includes this origin.
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001
